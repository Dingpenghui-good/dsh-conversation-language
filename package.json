{
  "name": "@dingpenghui/dsh-conversation-language",
  "version": "3.2.3",
  "description": "DSH plugin for switching conversation language between Chinese and English",
  "type": "module",
  "main": "./lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-store"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dingpenghui-good/dsh-conversation-language.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "conversation",
    "language",
    "cordis"
  ],
  "author": "Dingpenghui-good",
  "files": [
    "lib",
    "src",
    "package.json",
    "README.md",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@types/react": "^18.3.12",
    "lightningcss": "^1.29.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  }
}
